*.seed
*.swo
*.swp
*.vi
*.yo-rc.json
*.zip
*~
.ruby-version
lib-cov

# OS or Editor folders
*.esproj
*.sublime-project
*.sublime-workspace
._*
.cache
.DS_Store
.idea
.project
.settings
.tmproj
nbproject
Thumbs.db

# Komodo
*.komodoproject
.komodotools

# Vendor packages
node_modules

# General folders and files to ignore
tmp
temp
TODO.md
.tmp

# Environment files (keep .env.example)
.env
.env.local
.env.*.local

# Build output
dist-modern/
dist/
/public/build
/storage/framework/views/*
test_dropdown.js
/storage/app/public/products/*

# Regenerable diagnostic and scratch performance output
/storage/eslint.json
/storage/routes.json
/tests/performance/summary.json
/tests/performance/summary-corrected.json
/tests/performance/apis-summary.json
/tests/performance/apis-sweep.json
/tests/performance/pages-40vus-detailed.json
# Preserve resource evidence for the disposable HTTP performance runs.
!/tests/performance/results/*-isolated/*-resources.csv
!/tests/performance/results/*-isolated-stress/*-resources.csv
!/tests/performance/results/*-isolated-*/*-resources.csv

# Preserved read-only source backup from local audit work
/app/Services/.shipping-original/
/app/.imports-original/

# Private operational snapshots must never be committed.
/storage/app/private/permission-repairs/

# One-off release audit evidence is local operational data.
/storage/app/private/release-audits/

# Composer installs and Laravel discovery caches are generated per environment.
/vendor/
/bootstrap/cache/*.php

# Local databases, private recovery files, uploads and generated public links.
/database/*.sqlite*
/public/storage
/storefront/public/storage
/storage/app/private/
/storage/app/public/*
