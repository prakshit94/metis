# Enforce Unix newlines
* text=auto eol=lf

# Source files
*.css    text eol=lf
*.scss   text eol=lf
*.html   text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.svg    text eol=lf

# Binary files
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.png    binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary

# Source-control verification/diagnostics are not production application files.
/tests export-ignore
/storefront/tests export-ignore
/docs/audits export-ignore
/docs/screenshots export-ignore
/docs/reviews export-ignore
/docs/templates export-ignore
/docs/*.md export-ignore
/database/transitions export-ignore
/CLAUDE.md export-ignore
/CONTRIBUTING.md export-ignore
/DEVELOPMENT.md export-ignore
/CHANGELOG.md export-ignore

# Regenerable/private directories must not be packaged.
/vendor export-ignore
/node_modules export-ignore
/public/build export-ignore
/storage/app/private export-ignore
/migrationquery.text export-ignore
/migrationscripts.txt export-ignore
/public/storage export-ignore
/storefront/public/storage export-ignore
